# Local stack, as started by `npm run stack:up`. Host ports default one above
# the standard ones so this project can run alongside another local stack.
DATABASE_URL=postgres://seo:seo@localhost:5433/seo_optimizer
REDIS_URL=redis://localhost:6380

# Override the published host ports if these are taken too.
# POSTGRES_PORT=5433
# REDIS_PORT=6380
# MINIO_PORT=9002
# MINIO_CONSOLE_PORT=9003

# @seo/storage's blob store, against the local MinIO from `npm run stack:up`.
# The bucket does not exist until something creates it — tests do this
# themselves — or you make it once via the console at localhost:9003.
STORAGE_BUCKET=seo-optimizer-bodies
STORAGE_ACCESS_KEY_ID=seo-storage
STORAGE_SECRET_ACCESS_KEY=seo-storage-secret
STORAGE_ENDPOINT=http://localhost:9002
STORAGE_FORCE_PATH_STYLE=true
# STORAGE_REGION=us-east-1

# Swap the four lines above for a real bucket, region and IAM/HMAC keys (no
# STORAGE_ENDPOINT, STORAGE_FORCE_PATH_STYLE=false) to point at AWS S3, or
# STORAGE_ENDPOINT=https://storage.googleapis.com for GCS's S3-interop API.
